<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Chat Popup</title>
    <style>
        /* Popup Container */
        #adminChatPopup {
            display: none;
            position: fixed;
            top: 55%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 400px;
            background-color: #f9f9f9;
            border: 1px solid #ddd;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            z-index: 1000;
            font-family: Arial, sans-serif;
        }

        /* Overlay */
        #overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 999;
        }

        /* Header của popup */
        #popupHeader {
            background-color: #4caf50;
            color: white;
            padding: 10px;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
            text-align: center;
            font-size: 18px;
        }

        /* Close Button */
        .close-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: white;
        }

        /* Chat Messages Area */
        .chat-messages {
            height: 300px;
            overflow-y: auto;
            background-color: #ffffff;
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }

            /* Individual Message Styling */
            .chat-messages div {
                margin-bottom: 10px;
                padding: 8px;
                background-color: #e8f5e9;
                border-radius: 8px;
                word-wrap: break-word;
            }

                .chat-messages div.admin-message {
                    background-color: #f3e5f5;
                    text-align: right;
                }

        /* Input for User ID */
        #adminChatUser {
            display: block;
            width: calc(100% - 20px);
            margin: 10px auto;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
        }

        /* Textarea for Messages */
        #adminChatInput {
            display: block;
            width: calc(100% - 20px);
            margin: 10px auto;
            padding: 10px;
            height: 100px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
            resize: none;
            box-sizing: border-box;
        }

        /* Send Button */
        .send-btn {
            display: block;
            width: calc(100% - 20px);
            margin: 10px auto 20px auto;
            padding: 10px;
            background-color: #4caf50;
            color: white;
            font-size: 16px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

            .send-btn:hover {
                background-color: #45a049;
            }

        /* Nút mở popup */
        button.open-chat-btn {
            position: fixed;
            bottom: 20px;
            right: 20px;
            padding: 10px 15px;
            background-color: #4caf50;
            color: white;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            font-size: 16px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            transition: background-color 0.3s ease;
        }

            button.open-chat-btn:hover {
                background-color: #45a049;
            }
    </style>
</head>
<body>

    <!-- Nút mở popup -->
    <button class="open-chat-btn" onclick="openPopup()">Chat</button>

    <!-- Overlay -->
    <div id="overlay"></div>

    <!-- Admin Chat Popup -->
    <div id="adminChatPopup">
        <div id="popupHeader">
            Admin Chat
            <button class="close-btn" onclick="closePopup()">&times;</button>
        </div>
        <div id="adminChatMessages" class="chat-messages">
            <!-- Tin nhắn từ user hiển thị ở đây -->
        </div>
       @*  <input id="adminChatUser" type="text" placeholder="Enter User ID"> *@
      @*   <textarea id="adminChatInput" disabled placeholder="Type your message..."></textarea>
        <button class="send-btn" onclick="sendMessageToUser()">Send Reply</button> *@
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
    <script>
        // Mở popup
        function openPopup() {
            document.getElementById('adminChatPopup').style.display = 'block';
            document.getElementById('overlay').style.display = 'block';
        }

        // Đóng popup
        function closePopup() {
            document.getElementById('adminChatPopup').style.display = 'none';
            document.getElementById('overlay').style.display = 'none';
        }

        const adminConnection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        adminConnection.start()
            .then(() => console.log("SignalR connected for admin"))
            .catch(err => console.error("Connection failed: ", err));

        // Lắng nghe tin nhắn từ user
        adminConnection.on("ReceiveMessage", function (user, message) {
            const chatMessages = document.getElementById("adminChatMessages");
            const newMessage = document.createElement("div");

            const timeStamp = new Date().toLocaleString();

            newMessage.textContent = `${user}: ${message} (Received at: ${timeStamp})`;
            chatMessages.appendChild(newMessage);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        });

        function sendMessageToUser() {
            const userId = document.getElementById("adminChatUser").value.trim();
            const message = document.getElementById("adminChatInput").value.trim();

            if (!userId) {
                alert("User ID không được để trống.");
                return;
            }
            if (!message) {
                alert("Tin nhắn không được để trống.");
                return;
            }

            adminConnection.invoke("SendMessageToUser", userId, message)
                .then(() => {
                    // Hiển thị tin nhắn trong giao diện admin
                    const chatMessages = document.getElementById("adminChatMessages");
                    const newMessage = document.createElement("div");
                    const timeStamp = new Date().toLocaleString();

                    newMessage.textContent = `You: ${message} (Sent at: ${timeStamp})`;
                    newMessage.classList.add("admin-message");

                    chatMessages.appendChild(newMessage);
                    chatMessages.scrollTop = chatMessages.scrollHeight;

                    document.getElementById("adminChatInput").value = "";
                })
                .catch(err => console.error("Gửi thất bại: ", err));
        }
    </script>

</body>
</html>
