<style>
    /* Container for Admin Chat Section */
    #adminChatSection {
        width: 400px;
        margin: 20px auto;
        background-color: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        font-family: Arial, sans-serif;
        overflow: hidden;
    }

    /* Chat Messages Area */
    .chat-messages {
        height: 300px;
        overflow-y: auto;
        background-color: #ffffff;
        padding: 10px;
        border-bottom: 1px solid #ddd;
    }

        /* Individual Message Styling */
        .chat-messages div {
            margin-bottom: 10px;
            padding: 8px;
            background-color: #e8f5e9;
            border-radius: 8px;
            word-wrap: break-word;
        }

            .chat-messages div.admin-message {
                background-color: #f3e5f5;
                text-align: right;
            }

    /* Input for User ID */
    #adminChatUser {
        display: block;
        width: calc(100% - 20px);
        margin: 10px auto;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 14px;
    }

    /* Textarea for Messages */
    #adminChatInput {
        display: block;
        width: calc(100% - 20px);
        margin: 10px auto;
        padding: 10px;
        height: 100px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 14px;
        resize: none;
        box-sizing: border-box;
    }

    /* Send Button */
    .send-btn {
        display: block;
        width: calc(100% - 20px);
        margin: 10px auto;
        padding: 10px;
        background-color: #4caf50;
        color: white;
        font-size: 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .send-btn:hover {
            background-color: #45a049;
        }

    /* Scrollbar Customization */
    .chat-messages::-webkit-scrollbar {
        width: 8px;
    }

    .chat-messages::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .chat-messages::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 10px;
    }

        .chat-messages::-webkit-scrollbar-thumb:hover {
            background: #a1a1a1;
        }
</style>

<div id="adminChatSection">
    <input id="adminChatUser" placeholder="Enter User ID" />
    <div id="adminChatMessages" class="chat-messages">
        <!-- Tin nhắn từ user hiển thị ở đây -->
    </div>
    <textarea id="adminChatInput" placeholder="Type your message..."></textarea>
    <button class="send-btn" onclick="sendMessageToUser()">Send Reply</button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
<script>
    const adminConnection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .build();

    adminConnection.start()
        .then(() => console.log("SignalR connected for admin"))
        .catch(err => console.error("Connection failed: ", err));

    // Lắng nghe tin nhắn từ user
    adminConnection.on("ReceiveMessage", function (user, message) {
        const chatMessages = document.getElementById("adminChatMessages");
        const newMessage = document.createElement("div");
        newMessage.textContent = `${user}: ${message}`;
        chatMessages.appendChild(newMessage);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    });


    // Gửi tin nhắn từ admin tới user
    function sendMessageToUser() {
        const userId = document.getElementById("adminChatUser").value; // Lấy userId từ input
        const message = document.getElementById("adminChatInput").value; // Lấy tin nhắn từ textarea

        if (userId.trim() !== "" && message.trim() !== "") {
            adminConnection.invoke("SendMessageToUser", userId, message)
                .then(() => {
                    const chatMessages = document.getElementById("adminChatMessages");
                    const newMessage = document.createElement("div");

                    // Hiển thị tin nhắn từ admin
                    newMessage.textContent = `Admin: ${message}`;
                    newMessage.classList.add("admin-message");

                    chatMessages.appendChild(newMessage);
                    chatMessages.scrollTop = chatMessages.scrollHeight;

                    document.getElementById("adminChatInput").value = ""; // Clear input
                })
                .catch(err => console.error("Send failed: ", err));
        } else {
            alert("Please enter a valid user ID and message.");
        }
    }
</script>
