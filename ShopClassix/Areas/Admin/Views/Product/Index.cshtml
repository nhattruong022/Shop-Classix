@model IEnumerable<Shop_Classix.Models.ProductsModel>

@{
    ViewData["Title"] = "Product";
    Layout = "_AdminSubLayout";
    var productlist = ViewBag.Products;
}

@section Link {
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,600,800" rel="stylesheet">
    <link rel="icon" href="@Url.Content("~/Classix/admin/images/favicon.ico")" type="image/x-icon">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Classix/admin/css/bootstrap/css/bootstrap.min.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Classix/admin/icon/themify-icons/themify-icons.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Classix/admin/icon/icofont/css/icofont.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Classix/admin/css/style.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Classix/admin/css/jquery.mCustomScrollbar.css")">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
}

@section Scripts {
    <script type="text/javascript" src="@Url.Content("~/Classix/admin/js/jquery/jquery.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Classix/admin/js/jquery-ui/jquery-ui.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Classix/admin/js/popper.js/popper.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Classix/admin/js/bootstrap/js/bootstrap.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Classix/admin/js/jquery-slimscroll/jquery.slimscroll.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Classix/admin/js/modernizr/modernizr.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Classix/admin/js/modernizr/css-scrollbars.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Classix/admin/js/classie/classie.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Classix/admin/js/script.js")"></script>
    <script src="@Url.Content("~/Classix/admin/js/pcoded.min.js")"></script>
    <script src="@Url.Content("~/Classix/admin/js/demo-12.js")"></script>
    <script src="@Url.Content("~/Classix/admin/js/jquery.mCustomScrollbar.concat.min.js")"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Biến lưu trữ form hiện tại
        let currentForm = null;

        // Hàm hiển thị modal
        function showConfirmModal(event, form) {
            event.preventDefault(); // Ngăn form gửi đi
            currentForm = form;    // Lưu form hiện tại để xử lý khi xác nhận
            const modal = new bootstrap.Modal(document.getElementById('confirmDeleteModal'));
            modal.show();          // Hiển thị modal
        }

        // Xử lý khi nhấn nút Xóa trong modal
        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            if (currentForm) {
                currentForm.submit(); // Gửi form khi xác nhận
            }
        });
    </script>
}
<style>
    .centered {
        text-align: center;
        /* Căn giữa nội dung */
    }
</style>

<!-- Page-header start -->
<div class="page-header card">
    <div class="row align-items-end">
        <div class="col-lg-8">
            <div class="page-header-title">
                <i class="icofont icofont-table bg-c-blue"></i>
                <div class="d-inline">
                    <h4>Quản lý Admin </h4>
                    <span>lorem ipsum dolor sit amet, consectetur adipisicing elit</span>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="page-header-breadcrumb">
                <ul class="breadcrumb-title">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home", new { area = "Admin" })">
                            <i class="icofont icofont-home"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Product", new { area = "Admin" })">Products Management</a>
                    </li>

                </ul>
            </div>
        </div>
    </div>
</div>
<!-- Page-body start -->
<div class="page-body">
    <div class="card">
        <form method="get" asp-controller="Product" asp-action="Index">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-4">
                        <input type="text" name="name" class="form-control" id="searchInput"
                               placeholder="Search by Product Name">

                    </div>

                    <div class="col-md-4">
                        <select class="form-control" name="Cate" id="filterCategory">
                            <option value="">All Categories</option>
                            <option value="Table">Table</option>
                            <option value="Desk">Desk</option>
                            <option value="Light">Light</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-primary" type="submit" onclick="filterResults()">Search</button>
                    </div>
                </div>
            </div>
        </form>
        <!-- Page-body start -->
        <div class="page-body">
            <!-- Basic table card start -->
            <div class="card">
                <div class="card-header">
                    <h5>Table Orders</h5>
                    <div class="card-header-right">
                        <a href="@Url.Action("Add", "Product", new { area = "Admin" })" class="btn btn-success">Add Category</a>
                    </div>
                </div>

                @if (productlist != null)
                {
                    <div class="card-block table-border-style">
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Image</th>
                                        <th>Product Name</th>
                                        <th>Category</th>
                                        <th>Price</th>
                                        <th>Quantity</th>
                                        <th>Size</th>
                                        <th>Description</th>
                                        <th>Slug</th>
                                        <th>Status</th>
                                        <th colspan="2">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="table-product">
                                    @foreach (var item in productlist)
                                    {
                                        <tr>
                                            <td><img style="width: 150px;" src="~/Classix/img/@item.Image"></td>
                                            <td>@item.Name</td>
                                            <td>@item.category?.Name</td>
                                            <td>@item.Price</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.Size</td>
                                            <td>
                                                @item.Description
                                            </td>
                                            <td>@item.Slug</td>
                                            <td>
                                                @{
                                                    switch (item.Status)
                                                    {
                                                        case 0:
                                                            <span>Deleted</span>
                                                            break;
                                                        case 1:
                                                            <span>Active</span>
                                                            break;
                                                        default:
                                                            break;
                                                    }
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Edit", "Product", new { area = "Admin", id = item.Id })" class="btn btn-warning btn-sm">Edit</a>
                                            </td>
                                            <td>
                                                @{
                                                    switch (item.Status)
                                                    {
                                                        case 0:
                                                            <form asp-action="Activate" method="post">
                                                                <input type="hidden" value="@item.Id" name="id">
                                                                <button class="btn btn-sm btn-success" type="submit">Activate</button>
                                                            </form>
                                                            break;
                                                        case 1:
                                                            <form asp-action="Delete" method="post"
                                                                  onsubmit="showConfirmModal(event, this)">
                                                                <input type="hidden" value="@item.Id" name="id">
                                                                <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                                                            </form>
                                                            break;
                                                        default:
                                                            break;
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }


                else
                {
                    <div class="centered">
                        <h4>Không tìm thấy sản phẩm nào!</h4>
                    </div>
                }
            </div>

            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>
