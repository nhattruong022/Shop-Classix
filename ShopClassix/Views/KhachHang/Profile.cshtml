@model CustomerModel

@using Shop_Classix.Repository;

@{
    ViewData["Title"] = "Personal Information Page";

    var favoritelist = ViewBag.favoritelist as List<Shop_Classix.Models.ProductList>;
}


@section Link
{
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/bootstrap.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/font-awesome.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/elegant-icons.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/nice-select.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/jquery-ui.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/owl.carousel.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/slicknav.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/style.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/xuan.css")" type="text/css" />
}

<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav mx-auto">
            <li class="nav-item mx-3">
                <a class="nav-link" asp-controller="KhachHang" asp-action="MyOrder">All</a>
            </li>
            @foreach (var statusButton in new[]
            {
            new { Value = 1, Text = "Waiting for delivery" },
            new { Value = 2, Text = "Transport" },
            new { Value = 3, Text = "Completed" },
            new { Value = 4, Text = "Canceled" },
            new { Value = 6, Text = "Refund" }
            })
            {
                <li class="nav-item mx-3">
                    <form asp-controller="KhachHang" asp-action="MyOrder" method="post" style="display:none;">
                        <input type="hidden" name="status" value="@statusButton.Value" />
                    </form>
                    <a class="nav-link" href="#"
                        onclick="event.preventDefault(); this.previousElementSibling.submit();">@statusButton.Text</a>
                </li>
            }

            <li class="nav-item mx-3">
                <a class="nav-link" href="#">Bình luận/Đánh giá</a>
            </li>
        </ul>
    </div>
</nav>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body d-flex">
                    <img src="https://e7.pngegg.com/pngimages/550/997/png-clipart-user-icon-foreigners-avatar-child-face.png"
                        alt="Profile Image" class="profile-image" />
                    <div>
                        <h3 class="card-title">Personal Information</h3>
                        <div class="info-row">
                            <h4>Name:</h4>
                            <p>@Model.Name</p>
                        </div>
                        <div class="info-row">
                            <h4>Gender:</h4>
                            @{
                                switch (@Model.Gender)
                                {
                                    case false:
                                        <p>Male</p>
                                        break;
                                    case true:
                                        <p>Female</p>
                                        break;
                                }
                            }
                        </div>
                        <div class="info-row">
                            <h4>Address:</h4>
                            <p>@Model.Address</p>
                        </div>
                        <div class="info-row">
                            <h4>Phone:</h4>
                            <p>@Model.PhoneNumber</p>
                        </div>
                        <div class="info-row">
                            <h4>Date of Birth:</h4>
                            <p>@Model.DateOfBirth</p>
                        </div>
                        <div class="info-row">
                            <h4>Email:</h4>
                            <p>@Model.Email</p>
                        </div>
                        <button type="button" class="btn btn-primary">
                            Edit Information
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<section class="related-product">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title related__product__title">
                    <h2>Favorite Product</h2>
                </div>
            </div>
        </div>

        <div class="row">
            @foreach (var item in favoritelist)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="product__item">
                        <div class="product__item__pic set-bg"
                            data-setbg="https://woodfurniture.com/cdn/shop/products/DBOCWA3710N_1_600x.png?v=1650962550">
                            <ul class="product__item__pic__hover">
                                <li>
                                    <a href="#"><i class="fa fa-heart"></i></a>
                                </li>
                                <li>
                                    <a href="#"><i class="fa fa-retweet"></i></a>
                                </li>
                                <li>
                                    <a href="#"><i class="fa fa-shopping-cart"></i></a>
                                </li>
                            </ul>
                        </div>
                        <div class="product__item__text">
                            <h6><a href="#">@item.Name</a></h6>
                            <h5>@item.Price</h5>
                        </div>
                    </div>
                </div>
            }

        </div>

    </div>
</section>
<!-- Related Product Section End -->


<script src="@Url.Content("~/Classix/user/js/jquery-3.3.1.min.js")"></script>
<script src="@Url.Content("~/Classix/user/js/bootstrap.min.js")"></script>
<script src="@Url.Content("~/Classix/user/js/jquery.nice-select.min.js")"></script>
<script src="@Url.Content("~/Classix/user/js/jquery-ui.min.js")"></script>
<script src="@Url.Content("~/Classix/user/js/jquery.slicknav.js")"></script>
<script src="@Url.Content("~/Classix/user/js/mixitup.min.js")"></script>
<script src="@Url.Content("~/Classix/user/js/owl.carousel.min.js")"></script>
<script src="@Url.Content("~/Classix/user/js/main.js")"></script>