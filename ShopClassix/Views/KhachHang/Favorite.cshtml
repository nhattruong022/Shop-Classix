@{


    ViewData["Title"] = "Comments Page";

    var comment = ViewBag.comment;

    var favoritelist = ViewBag.favoritelist as List<Shop_Classix.Models.ProductList>;

    var status = ViewBag.status;
}

@section Link
{
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/bootstrap.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/font-awesome.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/elegant-icons.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/nice-select.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/jquery-ui.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/owl.carousel.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/slicknav.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/style.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/xuan.css")" type="text/css" />
}
<section class="related-product">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title related__product__title">
                    <h2>Favorite Product</h2>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Thay đổi ở đây: Thêm row cho các sản phẩm -->
            @foreach (var item in favoritelist)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="featured__item">
                        <div class="featured__item__pic set-bg" data-setbg="@Url.Content("~/Classix/img/" + item.Image)">
                            <a asp-action="Details" asp-controller="Home" asp-route-id="@item.Id">
                                <img src="@Url.Content("~/Classix/img/" + item.Image)" alt="Product Image" />
                            </a>
                            <ul class="featured__item__pic__hover">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <li>
                                        <a asp-action="Favorite" asp-controller="KhachHang" asp-route-id="@item.Id">
                                            <i id="favoriteIcon_@item.Id" class="fa fa-heart" style="color: red"></i>
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a href="#"><i class="fa fa-retweet"></i></a>
                                </li>
                                <li>
                                    <a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.Id" onclick="addToCart(event, @item.Id)">
                                        <i class="fa fa-shopping-cart"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="product__item__text">
                            <h6><a href="#">@item.Name</a></h6>
                            <h5>@item.Price</h5>
                            <p>
                                @for (var i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Floor(item.Rating ?? 0)) // Sao đầy
                                    {
                                        <i class="fa fa-star" style="color: gold;"></i>
                                    }
                                    else if (i == Math.Ceiling(item.Rating ?? 0) && (item.Rating ?? 0) % 1 != 0) // Sao nửa
                                    {
                                        <i class="fas fa-star-half-alt" style="color: gold;"></i>
                                    }
                                    else // Sao rỗng
                                    {
                                        <i class="fa fa-star" style="color: lightgray;"></i>
                                    }
                                }
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div> <!-- Kết thúc row -->
    </div>
</section>

@section Script
{
    <script src="@Url.Content("~/Classix/user/js/jquery-3.3.1.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery.nice-select.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery-ui.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery.slicknav.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/mixitup.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/owl.carousel.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/main.js")"></script>
   
}