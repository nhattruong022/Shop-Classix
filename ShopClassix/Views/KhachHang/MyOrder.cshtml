@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "My Order Page";
    var orders = ViewBag.Orders as List<Shop_Classix.Models.OrderModel>;
    var status = ViewBag.Status;
    var detail = ViewBag.Detail as List<Shop_Classix.Models.OrderDetailModel>;
}

@section Link
{
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/bootstrap.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/font-awesome.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/elegant-icons.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/nice-select.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/jquery-ui.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/owl.carousel.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/slicknav.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/style.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/xuan.css")" type="text/css" />
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
}


<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav mx-auto">
            <li class="nav-item mx-3">
                <a class="nav-link" asp-controller="KhachHang" asp-action="MyOrder">All</a>
            </li>
            @foreach (var statusButton in new[]
            {
            new { Value = 1, Text = "Waiting for delivery" },
            new { Value = 2, Text = "Transport" },
            new { Value = 3, Text = "Completed" },
            new { Value = 4, Text = "Pending cancellation confirmation" },
            new { Value = 5, Text = "Canceled" }
            })
            {
                <li class="nav-item mx-3">
                    <form asp-controller="KhachHang" asp-action="MyOrder" method="get" style="display:none;">
                        <input type="hidden" name="status" value="@statusButton.Value" />
                    </form>
                    <a class="nav-link" href="#"
                        onclick="event.preventDefault(); this.previousElementSibling.submit();">@statusButton.Text</a>
                </li>
            }
            <li class="nav-item mx-3">
                <a class="nav-link" href="#">Bình luận/Đánh giá</a>
            </li>
        </ul>
    </div>
</nav>

<table class="table">

    <thead>
        <tr>
            <th>Name</th>
            <th>Total Price</th>
            <th>Address</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Payment Method</th>
            <th>Detail</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody id="orderTableBody">
        @if (orders == null || !orders.Any())
        {
            <tr>
                <td colspan="8" class="text-center">No data available</td>
            </tr>
        }
        else
        {
            foreach (var order in orders)
            {
                <tr>
                    <td>@order.CustomerName</td>
                    <td>@order.TotalPrice</td>
                    <td>@order.Address</td>
                    <td>@order.Email</td>
                    <td>@order.Phone</td>
                    <td>
                        @if (string.Equals(@order.PaymentMethod, "COD"))
                        {
                            <p>COD (@order.deposit)</p>
                        }
                        else
                        {
                            <p>Credit Card</p>
                        }
                    </td>
                    <td>
                        <form asp-controller="KhachHang" asp-action="MyOrderDetail" method="post">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <button type="submit" class="btn btn-success">More</button>
                        </form>
                    </td>
                    <td>
                        @switch (order.Status)
                        {
                            case 1:
                            case 2:// Hủy
                                <form asp-controller="KhachHang" asp-action="CancelOrder" method="post">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <button type="submit" class="btn btn-danger"
                                        onsubmit="return confirm('Are you sure you want to Cancel?');">Cancel order</button>
                                </form>
                                break;
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                <a class="page-link" href="@Url.Action("MyOrder", new { page = i })">@i</a>
            </li>
        }
    </ul>
</nav>


<div class="modal fade" id="orderDetailModal" tabindex="-1" role="dialog" aria-labelledby="orderDetailModalLabel"
    aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="orderDetailModalLabel">Order Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @if (detail != null && detail.Any())
                {
                    foreach (var item in detail)
                    {
                        <tr>
                            <td><img style="width: 100px;" src="~/Classix/img/@item.Products.Image"></td>
                            <td>@item.Products.Name</td>
                            <td>@item.Products.Price</td>
                            <td>@item.Quantity</td>
                            <td>@(item.TotalPrice)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">No order details found.</td>
                    </tr>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script>
    function GetOrderUser(status = "", page = 1) {
        $.get(`/api/Order/user?status=${status}&page=${page}`, function (response) {
            console.log(response); // Kiểm tra giá trị của response

            if (response !== undefined && response !== null) {
                const tableBody = $('#orderTableBody');
                tableBody.empty();

                let ordersResponse = response.orders; // Giả sử response có trường orders

                if (!Array.isArray(ordersResponse) || ordersResponse.length === 0) {
                    tableBody.append('<tr><td colspan="8" class="text-center">No data available</td></tr>');
                } else {
                    ordersResponse.forEach(order => {
                        let paymentMethodDisplay = order.paymentMethod == "COD"
                            ? `<p>COD (${order.deposit})</p>`
                            : `<p>Credit Card</p>`;

                        let statusButton = ''; // Khởi tạo biến statusButton rỗng
                        switch (order.status) {
                            case 1:
                            case 2: // Hủy
                                statusButton = `<form class="order-form" action="/KhachHang/CancelOrder" method="post">
                                    <input type="hidden" name="orderId" value="${order.id}" />
                                    <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to Cancel?');">Cancel order</button>
                                </form>`;
                                break;
                            default:
                                statusButton = ''; // Không có nút nào
                        }

                        tableBody.append(`
                        <tr>
                            <td>${order.customerName}</td>
                            <td>${order.totalPrice}</td>
                            <td>${order.address}</td>
                            <td>${order.email}</td>
                            <td>${order.phone}</td>
                            <td>${paymentMethodDisplay}</td>
                            <td>
                                <button class="btn btn-success view-order-detail" data-order-id="${order.id}">More</button>
                            </td>
                            <td>${statusButton}</td>
                        </tr>
                    `);
                    });
                }
            }
        }).fail(function () {
            console.error('Lỗi khi lấy số lượt order');
        });
    }

    //Ajax Hủy đơn hàng
    $(document).on('submit', '.order-form', function (e) {
        e.preventDefault(); // Ngăn chặn hành động mặc định của form

        const form = $(this);
        const actionUrl = form.attr('action'); // Lấy URL từ thuộc tính action của form
        const orderId = form.find('input[name="orderId"]').val(); // Lấy ID đơn hàng

        $.post(actionUrl, { orderId: orderId })
            .done(function (response) {
                // Cập nhật giao diện người dùng sau khi thành công
                GetOrderUser();
            })
            .fail(function () {
                alert('Failed to complete the action. Please try again.');
            });
    });

    //Ajax hiển thị trang chi tiết
    jQuery.noConflict();
    jQuery(document).ready(function ($) {
        // Kiểm tra xem có tham số orderId trong URL không
        const params = new URLSearchParams(window.location.search);
        if (params.has('orderId')) {
            const orderId = params.get('orderId');
            loadOrderDetails(orderId);
        }

        // Ajax Hiển thị trang chi tiết
        $(document).on('click', '.view-order-detail', function () {
            const orderId = $(this).data('order-id');
            loadOrderDetails(orderId);
        });

        function loadOrderDetails(orderId) {
            $.post('/KhachHang/MyOrderDetail', { orderId: orderId })
                .done(function (response) {
                    console.log(response);
                    if (response && response.length > 0) {
                        let modalBody = $('#orderDetailModal .modal-body');
                        modalBody.empty(); // Xóa nội dung cũ

                        // Tạo bảng hiển thị chi tiết đơn hàng
                        let table = '<table class="table"><thead><tr><th>Product Image</th><th>Product Name</th><th>Price</th><th>Quantity</th><th>Total Price</th></tr></thead><tbody>';

                        response.forEach(item => {
                            table += `<tr>
                            <td><img src="/Classix/img/${item.products.image}" style="width: 100px;"></td>
                            <td>${item.products.name}</td>
                            <td>${item.products.price}</td>
                            <td>${item.quantity}</td>
                            <td>${item.totalPrice}</td>
                        </tr>`;
                        });

                        table += '</tbody></table>';
                        modalBody.html(table); // Cập nhật nội dung modal
                        $('#orderDetailModal').modal('show'); // Hiển thị modal

                        // Cập nhật URL
                        const url = new URL(window.location.href);
                        url.searchParams.set('orderId', orderId);
                        history.replaceState({}, '', url);
                    } else {
                        alert('No details found for this order.');
                    }
                })
                .fail(function () {
                    alert('Failed to load order details. Please try again.');
                });
        }

        // Xóa orderId khỏi URL khi đóng modal
        $('#orderDetailModal').on('hidden.bs.modal', function () {
            const url = new URL(window.location.href);
            url.searchParams.delete('orderId');
            history.replaceState({}, '', url);
        });
    });


    setInterval(() => {
        const params = new URLSearchParams(window.location.search);
        let status = params.has('status') ? parseInt(params.get('status')) : "";
        let page = params.has('page') ? parseInt(params.get('page')) : 1;
        console.log(page, status);

        GetOrderUser(status, page);

        function updateUrl(status, page) {
            const url = new URL(window.location.href);
            if (status !== null) {
                url.searchParams.set('status', status);
            } else {
                url.searchParams.delete('status');
            }
            url.searchParams.set('page', page);
            history.replaceState({}, '', url);
        }
    }, 1000);
</script>