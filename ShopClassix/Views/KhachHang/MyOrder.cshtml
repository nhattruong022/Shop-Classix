    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "My Order Page";
    var orders = ViewBag.Orders as List<Shop_Classix.Models.OrderModel>;
    var status = ViewBag.Status;
}

@section Link
{
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/bootstrap.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/font-awesome.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/elegant-icons.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/nice-select.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/jquery-ui.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/owl.carousel.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/slicknav.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/style.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/xuan.css")" type="text/css" />
}


<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav mx-auto">
            <li class="nav-item mx-3">
                <a class="nav-link" asp-controller="KhachHang" asp-action="MyOrder">All</a>
            </li>
            @foreach (var statusButton in new[]
            {
            new { Value = 1, Text = "Waiting for delivery" },
            new { Value = 2, Text = "Transport" },
            new { Value = 3, Text = "Completed" },
            new { Value = 4, Text = "Canceled" },
            new { Value = 5, Text = "Refund" }
            })
            {
                <li class="nav-item mx-3">
                    <form asp-controller="KhachHang" asp-action="MyOrder" method="get" style="display:none;">
                        <input type="hidden" name="status" value="@statusButton.Value" />
                    </form>
                    <a class="nav-link" href="#"
                        onclick="event.preventDefault(); this.previousElementSibling.submit();">@statusButton.Text</a>
                </li>
            }
            <li class="nav-item mx-3">
                <a class="nav-link" href="#">Bình luận/Đánh giá</a>
            </li>
        </ul>
    </div>
</nav>

<table class="table">

    <thead>
        <tr>
            <th>Name</th>
            <th>Total Price</th>
            <th>Address</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Payment Method</th>
            <th>Detail</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody id="orderTableBody">
        @if (orders == null || !orders.Any())
        {
            <tr>
                <td colspan="8" class="text-center">No data available</td>
            </tr>
        }
        else
        {
            foreach (var order in orders)
            {
                <tr>
                    <td>@order.CustomerName</td>
                    <td>@order.TotalPrice</td>
                    <td>@order.Address</td>
                    <td>@order.Email</td>
                    <td>@order.Phone</td>
                    <td>
                        @if (string.Equals(@order.PaymentMethod, "COD"))
                        {
                            <p>COD (@order.deposit)</p>
                        }
                        else
                        {
                            <p>Credit Card</p>
                        }
                    </td>
                    <td>
                        <form asp-controller="KhachHang" asp-action="MyOrderDetail" method="post">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <button type="submit" class="btn btn-success">More</button>
                        </form>
                    </td>
                    <td>
                        @switch (order.Status)
                        {
                            case 1:
                            case 2:// Hủy
                                <form asp-controller="KhachHang" asp-action="CancelOrder" method="post">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <button type="submit" class="btn btn-danger"
                                        onsubmit="return confirm('Are you sure you want to Cancel?');">Cancel order</button>
                                </form>
                                break;
                            case 3: // Hoàn trả
                                <form asp-controller="KhachHang" asp-action="RefundOrder" method="post">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <button type="submit" class="btn btn-warning"
                                        onsubmit="return confirm('Are you sure you want to Refund?');">Refund</button>
                                </form>
                                break;
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                <a class="page-link" href="@Url.Action("MyOrder", new { page = i })">@i</a>
            </li>
        }
    </ul>
</nav>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function GetOrderUser(status = "", page = 1) {
        $.get(`/api/Order/user?status=${status}&page=${page}`, function (response) {
            console.log(response); // Kiểm tra giá trị của response

            if (response !== undefined && response !== null) {
                const tableBody = $('#orderTableBody');
                tableBody.empty();

                let ordersResponse = response.orders; // Giả sử response có trường orders

                if (!Array.isArray(ordersResponse) || ordersResponse.length === 0) {
                    tableBody.append('<tr><td colspan="8" class="text-center">No data available</td></tr>');
                } else {
                    ordersResponse.forEach(order => {
                        let paymentMethodDisplay = order.paymentMethod == "COD"
                            ? `<p>COD (${order.deposit})</p>`
                            : `<p>Credit Card</p>`;

                        let statusButton;
                        switch (order.status) {
                            case 1:
                            case 2: // Hủy
                                statusButton = `<form asp-controller="KhachHang" asp-action="CancelOrder" method="post">
                                <input type="hidden" name="orderId" value="${order.id}" />
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to Cancel?');">Cancel order</button>
                            </form>`;
                                break;
                            case 3: // Hoàn trả
                                statusButton = `<form asp-controller="KhachHang" asp-action="RefundOrder" method="post">
                                <input type="hidden" name="orderId" value="${order.id}" />
                                <button type="submit" class="btn btn-warning" onclick="return confirm('Are you sure you want to Refund?');">Refund</button>
                            </form>`;
                                break;
                            default:
                                statusButton = ''; // Không có nút nào
                        }

                        tableBody.append(`
                        <tr>
                            <td>${order.customerName}</td>
                            <td>${order.totalPrice}</td>
                            <td>${order.address}</td>
                            <td>${order.email}</td>
                            <td>${order.phone}</td>
                            <td>${paymentMethodDisplay}</td>
                            <td>
                                <form asp-controller="KhachHang" asp-action="MyOrderDetail" method="post">
                                    <input type="hidden" name="orderId" value="${order.id}" />
                                    <button type="submit" class="btn btn-success">More</button>
                                </form>
                            </td>
                            <td>${statusButton}</td>
                        </tr>
                    `);
                    });
                }
            }
        }).fail(function () {
            console.error('Lỗi khi lấy số lượt order');
        });
    }

    setInterval(() => {
        const params = new URLSearchParams(window.location.search);
        let status = params.has('status') ? parseInt(params.get('status')) : "";
        let page = params.has('page') ? parseInt(params.get('page')) : 1;
        console.log(page, status);

        GetOrderUser(status, page);

        function updateUrl(status, page) {
            const url = new URL(window.location.href);
            if (status !== null) {
                url.searchParams.set('status', status);
            } else {
                url.searchParams.delete('status');
            }
            url.searchParams.set('page', page);
            history.replaceState({}, '', url);
        }
    }, 10000);
</script>