<div class="container">
    <main role="main" class="pb-3">
        <!-- Breadcrumb Section Begin -->
        <section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/Classix/img/classix.jpg")">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12 text-center">
                        <div class="breadcrumb__text">
                            <h2>Shop Detail</h2>
                            <div class="breadcrumb__option"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Breadcrumb Section End -->
        <!-- Product Details Section Begin -->
        <section class="product-details spad">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6 col-md-6">
                        <div class="product__details__pic">
                            <div class="product__details__pic__item">
                                <img class="product__details__pic__item--large"
                                     src="@Url.Content("~/Classix/img/lamp.jpg")"
                                     alt="" />
                            </div>
                            <div class="product__details__pic__slider owl-carousel">
                                <img data-imgbigurl="img/lamp.jpg"
                                     src="@Url.Content("~/Classix/img/lamp.jpg")"
                                     alt="" />
                                <img data-imgbigurl="img/lamp1.jpg"
                                     src="@Url.Content("~/Classix/img/lamp1.jpg")"
                                     alt="" />
                                <img data-imgbigurl="img/lamp2.jpg"
                                     src="@Url.Content("~/Classix/img/lamp2.jpg")"
                                     alt="" />
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6">
                        <div class="product__details__text">
                            <h3>dBodhi Drum</h3>
                            <div class="product__details__rating">
                                <i class="fa fa-star"></i>
                                <i class="fa fa-star"></i>
                                <i class="fa fa-star"></i>
                                <i class="fa fa-star"></i>
                                <i class="fa fa-star-half-o"></i>
                                <span>(18 reviews)</span>
                            </div>
                            <div class="product__details__price">3.000.000VNĐ</div>
                            <p>
                                Wooden lamps are unique furniture pieces that not only
                                provide light but also bring natural beauty and warmth to
                                living spaces. Crafted from high-quality natural wood,
                                wooden lamps often feature elegant and sophisticated
                                designs, making them suitable for a variety of decor styles,
                                from modern to classic.
                            </p>
                            <div class="product__details__quantity">
                                <div class="quantity">
                                    <div class="pro-qty">
                                        <input type="text" value="1" />
                                    </div>
                                </div>
                            </div>
                            <a href="#" class="primary-btn">ADD TO CARD</a>
                            <a href="#" class="heart-icon">
                                <span class="icon_heart_alt"></span>
                            </a>
                            <ul>
                                <li>
                                    <b>Small: </b>
                                    <span>W24 x D24 x H15 in | W60 x D60 x H38 cm</span>
                                </li>
                                <li>
                                    <b>Large: </b>
                                    <span>W31 x D31 x H20 in | W80 x D80 x H51 cm</span>
                                </li>
                                <li><b>Cord Length: </b> <span> 78 in | 198 cm</span></li>
                                <li><b>Material | Rattan and Reclaimed Teak</b></li>
                                <li><b>Organic shape</b></li>
                                <li><b>Handwoven rattan detailing</b></li>
                                <li><b>Natural, refined look</b></li>
                            </ul>
                        </div>
                    </div>
                    
                    <div class="col-lg-12">
                        <div class="product__details__tab">
                            <ul class="nav nav-tabs" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       data-toggle="tab"
                                       href="#tabs-1"
                                       role="tab"
                                       aria-selected="true">Description</a>
                                </li>
