<script>
    function toggleFavorite(productId) {
        // Gửi yêu cầu POST tới server
        $.post('/Home/ToggleFavorite', { productId: productId }, function (response) {
            // Kiểm tra nếu yêu cầu thành công
            if (response.success) {
                const heartIcon = $(`#favoriteIcon_${productId}`);
                const favoriteCount = $(`#favoriteCount_${productId}`);

                // Cập nhật biểu tượng yêu thích
                heartIcon.toggleClass('fa-heart fa-heart-o');
                heartIcon.css('color', response.isFavorite ? 'red' : 'gray');

                // Cập nhật số lượng "tym"
                if (favoriteCount.length > 0) {
                    favoriteCount.text(response.favoriteCount);
                }
            } else {
                alert('Có lỗi xảy ra! Vui lòng thử lại.');
            }
        })
            .fail(function () {
                alert('Không thể kết nối với server. Vui lòng kiểm tra lại kết nối.');
            });
    }
</script>



