<div class="container">
    <main role="main" class="pb-3">
        <!-- Breadcrumb Section Begin -->
        <section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/Classix/img/classix.jpg")">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12 text-center">
                        <div class="breadcrumb__text">
                            <h2>Shop Detail</h2>
                            <div class="breadcrumb__option"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Breadcrumb Section End -->
        <!-- Product Details Section Begin -->
        <section class="product-details spad">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6 col-md-6">
                        <div class="product__details__pic">
                            <div class="product__details__pic__item">
                                <img class="product__details__pic__item--large"
                                    src="@Url.Content("~/Classix/img/" + Model.First().Image)" alt="" />
                            </div>

                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6">
                        <div class="product__details__text">
                            <h3>@Model.First().Name</h3>
                            <div class="product__details__rating">
                                <span id="rating">@rating</span> <i class="fa fa-star"></i>
                               
                                <span id="reviews">(@reviews) </span><span id="viewcount">| (@views)</span>
                            </div>
                            <div class="product__details__price"> @Model.First().Price.ToString("C")VNĐ</div>
                            <p>
                                @Model.First().Description
                            </p>
                            @* 
                            <div class="product__details__quantity">
                                <div class="quantity">
                                    <div class="pro-qty">
                                        <input type="number" id="quantity" value="1" min="1" />
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" id="productId" value="@Model.First().Id" />
                            <button onclick="addToCart(event, '@Model.First().Id')" class="primary-btn">ADD TO CART</button>
 *@
                            <form onsubmit="addToCart(event, '@Model.First().Id')">
                                <div class="product__details__quantity">
                                    <div class="quantity">
                                        <div class="pro-qty">
                                            <input type="number" id="quantity" name="quantity" value="1" min="1" />
                                        </div>
                                    </div>
                                </div>
                                <input type="hidden" name="id" value="@Model.First().Id" />
                                <button type="submit" class="primary-btn">ADD TO CART</button>
                            </form>


                            <a href="#" class="heart-icon">
                                <span class="icon_heart_alt"></span>
                            </a>
                            <span id="favorite"> @favorite</span>
                            <ul>
                                <li>
                                    <b>Size: </b>
                                    <span>@Model.First().Size</span>
                                </li>

                            </ul>
                        </div>
                    </div>
                    <script>
                        function addToCart(event, itemId) {
                            event.preventDefault(); // Ngăn chặn việc tải lại trang

                            var quantity = document.getElementById('quantity').value;

                            var formData = new URLSearchParams();
                            formData.append('id', itemId);
                            formData.append('quantity', quantity);

                            fetch('/Cart/AddToCart', {
                                method: 'POST',
                                body: formData,
                                headers: {
                                    'X-Requested-With': 'XMLHttpRequest'
                                }
                            })
                                .then(response => {
                                    if (response.ok) {
                                        return response.json();
                                    } else {
                                        throw new Error('Có lỗi xảy ra khi thêm vào giỏ.');
                                    }
                                })
                                .then(data => {
                                    alert(data.message); // Hiển thị thông báo thành công
                                })
                                .catch(error => {
                                    console.error('Error:', error);
                                    alert('Có lỗi xảy ra.');
                                });
                        }
                    </script>

                    <div class="col-lg-12">
                        <div class="product__details__tab">
                            <ul class="nav nav-tabs" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" data-toggle="tab" href="#tabs-1" role="tab"
                                        aria-selected="true">Description</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-toggle="tab" href="#tabs-2" role="tab"
                                        aria-selected="false">Information</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-toggle="tab" href="#tabs-3" role="tab"
                                        aria-selected="false">Reviews <span>(1)</span></a>
                                </li>
                            </ul>
                            <div class="tab-content">
                                <div class="tab-pane active" id="tabs-1" role="tabpanel">
                                    <div class="product__details__tab__desc">
                                        <h6>Products Infomation</h6>
                                        <p>
                                            The Drum Lamp shows subtle details, adapted in a pure
                                            shape. The organically shaped rattan lines that give
                                            the Drum its decorative and distinctive look are
                                            handwoven according to Javanese technique. A beautiful
                                            statement pendant that will literally brighten up the
                                            room. Available in two sizes and in charcoal or
                                            natural finish.
                                        </p>
                                        <p>
                                            The Drum Lamp shows subtle details, adapted in a pure
                                            shape. The organically shaped rattan lines that give
                                            the Drum its decorative and distinctive look are
                                            handwoven according to Javanese technique. A beautiful
                                            statement pendant that will literally brighten up the
                                            room. Available in two sizes and in charcoal or
                                            natural finish.
                                        </p>
                                    </div>
                                </div>
                                <div class="tab-pane" id="tabs-2" role="tabpanel">
                                    <div class="product__details__tab__desc">
                                        <h6>Products Infomation</h6>
                                        <p>
                                            The Drum Lamp shows subtle details, adapted in a pure
                                            shape. The organically shaped rattan lines that give
                                            the Drum its decorative and distinctive look are
                                            handwoven according to Javanese technique. A beautiful
                                            statement pendant that will literally brighten up the
                                            room. Available in two sizes and in charcoal or
                                            natural finish.
                                        </p>
                                        <p>
                                            The Drum Lamp shows subtle details, adapted in a pure
                                            shape. The organically shaped rattan lines that give
                                            the Drum its decorative and distinctive look are
                                            handwoven according to Javanese technique. A beautiful
                                            statement pendant that will literally brighten up the
                                            room. Available in two sizes and in charcoal or
                                            natural finish.
                                        </p>
                                    </div>
                                </div>
                                <div class="tab-pane" id="tabs-3" role="tabpanel">
                                    <div class="product__details__tab__desc">
                                        <h6>Products Infomation</h6>
                                        <p>
                                            The Drum Lamp shows subtle details, adapted in a pure
                                            shape. The organically shaped rattan lines that give
                                            the Drum its decorative and distinctive look are
                                            handwoven according to Javanese technique. A beautiful
                                            statement pendant that will literally brighten up the
                                            room. Available in two sizes and in charcoal or
                                            natural finish.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>



                </div>
            </div>

        </section>
        <!-- Product Details Section End -->


        <!-- Related Product Section Begin -->
        <section class="related-product">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="section-title related__product__title">
                            <h2>Related Product</h2>
                        </div>
                    </div>
                </div>
                <div class="row">
                    @foreach (var item in ViewBag.RelatedProducts)
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <div class="product__item">
                                <div class="product__item__pic set-bg"
                                    data-setbg='@Url.Content("~/Classix/img/" + item.Image)'>
                                    <ul class="product__item__pic__hover">
                                        <li>
                                            <a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.Id">
                                                <i class="fa fa-shopping-cart"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="product__item__text">
                                    <h6><a href="#">@item.Name</a></h6>
                                    <h5>@string.Format("{0:0,0} VND",item.Price)</h5>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
        <!-- Related Product Section End -->

    </main>
</div>



@section Script
{
    <script src="@Url.Content("~/Classix/user/js/jquery-3.3.1.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery.nice-select.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery-ui.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery.slicknav.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/mixitup.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/owl.carousel.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/main.js")"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>

        function GetViewCount() {

            $.get(`/api/Product/${@productid}/viewcount`, function (response) {

                console.log(response); // Kiểm tra giá trị của response

                if (response !== undefined && response !== null) {

                    // Kiểm tra nếu response là một số hợp lệ

                    let views = parseInt(response, 10);

                    if (!isNaN(views)) {

                        $('#viewcount').text(`| (${views} views)`); // Hiển thị giá trị dưới định dạng chính xác

                    } else {

                        console.error('viewcount không phải là một số hợp lệ');

                    }

                } else {

                    console.error('viewcount không có trong phản hồi');

                }

            }).fail(function () {

                console.error('Lỗi khi lấy số lượt views');

            });

        }

        // Gọi hàm updateViewCount

        setInterval(GetViewCount, 10);

    </script>
    <script>

        function GetReviews() {

            $.get(`/api/ProductComment/${@productid}/reviews`, function (response) {

                console.log(response); // Kiểm tra giá trị của response

                if (response !== undefined && response !== null) {

                    // Kiểm tra nếu response là một số hợp lệ

                    let count = parseInt(response, 10);

                    if (!isNaN(count)) {

                        $('#reviews').text(`| (${count} reviews)`); // Hiển thị giá trị dưới định dạng chính xác

                    } else {

                        console.error('reviews không phải là một số hợp lệ');

                    }

                } else {

                    console.error('reviews không có trong phản hồi');

                }

            }).fail(function () {

                console.error('Lỗi khi lấy số lượt reviews');

            });

        }

        // Gọi hàm updateViewCount

        setInterval(GetReviews, 10);

    </script>

    <script>

        function GetFavorite() {

            $.get(`/api/Product/${@productid}/favorite`, function (response) {

                console.log(response); // Kiểm tra giá trị của response

                if (response !== undefined && response !== null) {

                    // Kiểm tra nếu response là một số hợp lệ

                    let favorite = parseInt(response, 10);

                    if (!isNaN(favorite)) {

                        $('#favorite').text(` (${favorite} favorite)`); // Hiển thị giá trị dưới định dạng chính xác

                    } else {

                        console.error('favorite không phải là một số hợp lệ');

                    }

                } else {

                    console.error('favorite không có trong phản hồi');

                }

            }).fail(function () {

                console.error('Lỗi khi lấy số lượt favorite');

            });

        }

        // Gọi hàm updateViewCount

        setInterval(GetFavorite, 10);

    </script>
    <script>
        function GetRating() {
            $.get(`/api/ProductComment/${@productid}/rating`, function (response) {
                console.log(response); // Kiểm tra giá trị của response

                if (response !== undefined && response !== null) {
                    // Kiểm tra nếu response là một số hợp lệ
                    let rating = parseFloat(response);
                    if (!isNaN(rating)) {
                        $('#rating').text(`${rating.toFixed(1)}`); // Hiển thị giá trị với 1 chữ số thập phân
                    } else {
                        console.error('rating không phải là một số hợp lệ');
                    }
                } else {
                    console.error('rating không có trong phản hồi');
                }
            }).fail(function () {
                console.error('Lỗi khi lấy số lượt rating');
            });
        }

        // Gọi hàm GetRating mỗi 10 giây
        setInterval(GetRating, 10000); // Thay đổi 10 thành 10000 để gọi mỗi 10 giây

        // Gọi hàm ngay khi tải trang để có giá trị ban đầu
        $(document).ready(function () {
            GetRating();
        });
    </script>
}