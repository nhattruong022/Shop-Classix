                                        return response.text().then(errorText => {
                                            throw new Error(errorText);
                                        });
                                    }
                                })
                                .then(data => {
                                    alert(data.message); // Hiển thị thông báo thành công
                                })
                                .catch(error => {
                                    console.error('Error:', error);
                                    alert(error.message); // Hiển thị thông báo lỗi
                                });
                        }
                    </script> *@

                    <div class="col-lg-12">
                        <div class="product__details__tab">
                            <ul class="nav nav-tabs" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" data-toggle="tab" href="#tabs-1" role="tab"
                                        aria-selected="true">Description</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-toggle="tab" href="#tabs-2" role="tab"
                                        aria-selected="false">Information</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-toggle="tab" href="#tabs-3" role="tab"
                                        aria-selected="false">Reviews</a>
                                </li>
                            </ul>
                            <div class="tab-content">
                                <div class="tab-pane active" id="tabs-1" role="tabpanel">
                                    <div class="product__details__tab__desc">
                                        <h6>Products Description</h6>
                                        <p>@product.Description</p>
                                    </div>
                                </div>
                                <div class="tab-pane" id="tabs-2" role="tabpanel">
                                    <div class="product__details__tab__desc">
                                        <h6>Products Infomation</h6>
                                        <p>@product.Size</p>
                                    </div>
                                </div>
                                <div class="tab-pane" id="tabs-3" role="tabpanel">
                                    @if (comments != null)
                                    {
                                        <ul>
                                            @foreach (var comment in comments)
                                            {
                                                <li>
                                                    <strong>@comment.customers.Name</strong>
                                                    ⭐️ @comment.Rating/5
                                                    <p>@comment.Content</p>
                                                    <small>@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p>This product doesn't have any comment.</p>
                                    }

                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <form method="post" asp-controller="Home" asp-action="AddComment">
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <textarea name="content" placeholder="Enter the comment ..." required></textarea>
                                            <label>Rating: </label>
                                            <select name="rating">
                                                <option value="5">⭐⭐⭐⭐⭐</option>
                                                <option value="4">⭐⭐⭐⭐</option>
                                                <option value="3">⭐⭐⭐</option>
                                                <option value="2">⭐⭐</option>
                                                <option value="1">⭐</option>
                                            </select>
                                            <br />
                                            <button class="btn btn-sm btn-primary"type="submit">Comment</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </section>
        <!-- Product Details Section End -->
        <div class="rating-section mb-5">
            <h4>Rate this product</h4>
            <form id="ratingForm">
                <div class="rating-stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <input type="radio" id="star-@i" name="rating" value="@i" />
                        <label for="star-@i" title="@i star">
                            <i class="fa fa-star"></i> <!-- Biểu tượng sao đầy -->
                        </label>
                    }
                </div>
                <textarea name="review" id="review" rows="4" placeholder="Write your review here..." required></textarea>
                <button type="submit" class="primary-btn">Submit Rating</button>
            </form>
        </div>
        <!-- Related Product Section Begin -->
        <section class="related-product">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="section-title related__product__title">
                            <h2>Related Product</h2>
                        </div>
                    </div>
                </div>
                <div class="row">
                    @foreach (var item in ViewBag.RelatedProducts)
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <div class="product__item">
                                <div class="product__item__pic set-bg"
                                    data-setbg='@Url.Content("~/Classix/img/" + item.Image)'>
                                    <ul class="product__item__pic__hover">
                                        <li>
                                            <a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.Id">
                                                <i class="fa fa-shopping-cart"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="product__item__text">
                                    <h6><a href="#">@item.Name</a></h6>
                                    <h5>@string.Format("{0:0,0} VND",item.Price)</h5>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
        <!-- Related Product Section End -->

    </main>
</div>


@section Script
{
    <script src="@Url.Content("~/Classix/user/js/jquery-3.3.1.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery.nice-select.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery-ui.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery.slicknav.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/mixitup.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/owl.carousel.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/main.js")"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>


        document.addEventListener("DOMContentLoaded", function () {
            var loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
            document.getElementById("loginLink").addEventListener("click", function (event) {
                event.preventDefault();  // Ngừng hành động mặc định (tránh nhảy trang mới)
                loginModal.show();  // Hiển thị modal đăng nhập
            });
        });
    </script>



    <script>
        function GetViewCount() {
            $.get(`/api/Product/${@product.Id}/viewcount`, function (response) {
                if (response !== undefined && response !== null) {
                    let views = parseInt(response, 10);
                    if (!isNaN(views)) {
                        $('#viewcount').text(`| (${views} views)`);
                    }
                }
            }).fail(function () {
                console.error('Lỗi khi lấy số lượt views');
            });
        }
        setInterval(GetViewCount, 10000);

        function GetReviews() {
            $.get(`/api/ProductComment/${@product.Id}/reviews`, function (response) {
                if (response !== undefined && response !== null) {
                    let count = parseInt(response, 10);
                    if (!isNaN(count)) {
                        $('#reviews').text(`| (${count} reviews)`);
                    }
                }
            }).fail(function () {
                console.error('Lỗi khi lấy số lượt reviews');
            });
        }
        setInterval(GetReviews, 10000);

        function GetFavorite() {
            $.get(`/api/Product/${@product.Id}/favorite`, function (response) {
                if (response !== undefined && response !== null) {
                    let favorite = parseInt(response, 10);
                    if (!isNaN(favorite)) {
                        $('#favorite').text(` (${favorite} favorite)`);
                    }
                }
            }).fail(function () {
                console.error('Lỗi khi lấy số lượt favorite');
            });
        }
        setInterval(GetFavorite, 10000);

        function GetRating() {
            $.get(`/api/ProductComment/${@product.Id}/rating`, function (response) {
                if (response !== undefined && response !== null) {
                    let rating = parseFloat(response);
                    if (!isNaN(rating)) {
                        $('#rating').text(`${rating.toFixed(1)}`);
                    }
                }
            }).fail(function () {
                console.error('Lỗi khi lấy số lượt rating');
            });
        }
        setInterval(GetRating, 10000);

        function GetQuantity() {
            $.get(`/api/Product/${@product.Id}/quantitys`, function (response) {
                if (response !== undefined && response !== null) {
                    let quantity = parseInt(response, 10);
                    if (!isNaN(quantity)) {
                        if (quantity > 0) {
                            $('#quantitys').text(`${quantity}`);
                        } else {
                            $('#quantitys').text(` out of stock`);
                        }
                    }
                }
            }).fail(function () {
                console.error('Lỗi khi lấy số lượt quantitys');
            });
        }
        setInterval(GetQuantity, 10000);

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/productHub")
            .build();

        connection.start().catch(err => console.error(err.toString()));

        connection.on("ReceiveProductCount", function (count) {
            document.getElementById("productCount").innerText = count;
        });

        // Xử lý sự kiện submit đánh giá
        $('#ratingForm').submit(function (event) {
            event.preventDefault();

            const rating = $('input[name="rating"]:checked').val();
            const review = $('#review').val();

            $.post('/api/ProductComment/submit', { productId: '@product.Id', rating, review })
                .done(function (response) {
                    alert('Thank you for your review!');
                    GetReviews(); // Cập nhật lại số reviews
                    GetRating(); // Cập nhật lại rating
                })
                .fail(function () {
                    alert('Failed to submit your review. Please try again.');
                });
        });

        // Cập nhật giao diện sao đánh giá khi người dùng thay đổi sao
        document.querySelectorAll('.rating-stars input').forEach((input, index) => {
            input.addEventListener('change', () => {
                document.querySelectorAll('.rating-stars label i').forEach((star, starIndex) => {
                    if (starIndex <= index) {
                        star.classList.remove('fa-star-o');
                        star.classList.add('fa-star');
                    } else {
                        star.classList.remove('fa-star');
                        star.classList.add('fa-star-o');
                    }
                });
            });
        });
    </script>

}
