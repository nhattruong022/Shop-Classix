@model IEnumerable<Shop_Classix.Models.ProductsModel>
@{







    ViewData["Title"] = "Detail Page";

    var views = ViewBag.view;

    var productid = ViewBag.productid;

    var reviews = ViewBag.reviews;

    var rating = ViewBag.rating;
    var favorite = ViewBag.favorite;

   
}


@section Link
{
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400;600;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/bootstrap.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/font-awesome.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/elegant-icons.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/nice-select.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/jquery-ui.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/owl.carousel.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/slicknav.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/style.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/detail.css")" type="text/css" />
