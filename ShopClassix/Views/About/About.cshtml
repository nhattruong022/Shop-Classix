
@{
    ViewData["Title"] = "About Page";
}


<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400;600;900&display=swap"
      rel="stylesheet" />
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/bootstrap.min.css")" type="text/css" />
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/font-awesome.min.css")" type="text/css" />
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/elegant-icons.css")" type="text/css" />
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/nice-select.css")" type="text/css" />
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/jquery-ui.min.css")" type="text/css" />
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/owl.carousel.min.css")" type="text/css" />
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/slicknav.min.css")" type="text/css" />
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/style.css")" type="text/css" />



<div class="container">
    <main role="main" class="pb-3">
        <!-- Blog Details Hero Begin -->
        <section class="blog-details-hero set-bg" data-setbg="@Url.Content("~/Classix/img/classix.jpg")">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="blog__details__hero__text">
                            <h2>About Classix Shop</h2>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Blog Details Hero End -->
        <!-- Blog Details Section Begin -->
        <section class="blog-details spad">
            <div class="container">
                <h3>About Classsix</h3>
                <p>
                    Welcome to Classsix, your premier online store for high-quality
                    wooden furniture! With a mission to provide unique and elegant
                    wooden products, Classsix is the ideal destination for those who
                    appreciate the natural beauty and durability of wood.
                </p>

                <img src="@Url.Content("~/Classix/img/Shop.jpg")" />
                <h3>Vision and Mission</h3>
                <p>
                    At Classsix, we believe that every product tells its own story. We
                    are committed to offering our customers wooden items that are not
                    only aesthetically pleasing but also durable and functional. Our
                    mission is to connect consumers with sustainable, eco-friendly
                    wooden products that enhance their living spaces.
                </p>
                <h3>Our Products</h3>
                <p>We offer a diverse range of wooden products, including:</p>
                <p>
                    Furniture: Modern and stylish tables and chairs that fit any
                    living space.
                </p>
                <p>
                    Beds: Crafted from natural wood, providing comfort and style for
                    your bedroom.
                </p>
                <p>
                    Bookshelves and Display Cabinets: Help you organize your space
                    beautifully and efficiently.
                </p>
                <p>
                    Decorative Accessories: Small yet meaningful items that elevate
                    your home decor.
                </p>
                <img src="@Url.Content("~/Classix/img/classix.jpg")" />
                <h3>Quality Commitment</h3>
                <p>
                    All products at Classsix are made from high-quality natural wood
                    and undergo rigorous quality checks. We pay close attention to
                    every detail, from design to finishing, ensuring that each product
                    meets the highest standards.
                </p>
                <h3>Customer Service</h3>
                <p>
                    Our team at Classsix is always ready to assist you from
                    consultation to delivery. We are committed to providing a seamless
                    online shopping experience for our customers.
                </p>
                <h3>Connect with Us</h3>
                <p>
                    Visit our website to explore our extensive collection and keep an
                    eye out for exciting promotions. Classsix looks forward to helping
                    you create the perfect living space with our wonderful wooden
                    products!
                </p>
                <span>Thank you for choosing Classsix!</span>
            </div>
        </section>
        <!-- Blog Details Section End -->
    </main>
</div>


<script src="@Url.Content("~/Classix/user/js/jquery-3.3.1.min.js")"></script>
<script src="@Url.Content("~/Classix/user/js/bootstrap.min.js")"></script>
<script src="@Url.Content("~/Classix/user/js/jquery.nice-select.min.js")"></script>
<script src="@Url.Content("~/Classix/user/js/jquery-ui.min.js")"></script>
<script src="@Url.Content("~/Classix/user/js/jquery.slicknav.js")"></script>
<script src="@Url.Content("~/Classix/user/js/mixitup.min.js")"></script>
<script src="@Url.Content("~/Classix/user/js/owl.carousel.min.js")"></script>
<script src="@Url.Content("~/Classix/user/js/main.js")"></script>