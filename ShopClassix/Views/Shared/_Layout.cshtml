<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shop_Classix</title>
    @RenderSection("Link", required: false)
</head>

<body>
    @await Html.PartialAsync("Header");
    @* @await Html.PartialAsync("Section"); *@

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="loginModalLabel">Login</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form method="post" asp-action="Login" asp-controller="KhachHang">
                        <div class="mb-3">
                            <label for="Email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="Email" name="Email" required />
                        </div>
                        <div class="mb-3">
                            <label for="Password" class="form-label">Password</label>
                            <input type="password" class="form-control" id="Password" name="Password" required />
                        </div>
                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary">Login</button>
                        </div>
                    <div class="text-center mt-3">
                            <p>Don't have an account ? <a href="/KhachHang/Register">Register Now</a></p>
                    </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("Chat");

    @await Html.PartialAsync("Footer");



    @RenderSection("Script", required: false)
</body>

</html>
