@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    var address = HttpContextAccessor.HttpContext.Session.GetString("Address");
    var phone = HttpContextAccessor.HttpContext.Session.GetString("Phone");
    var email = HttpContextAccessor.HttpContext.Session.GetString("Email");
    var Logo = HttpContextAccessor.HttpContext.Session.GetString("Logo");

}

<footer class="footer spad">
    <div class="container">
        <div class="row">
          

                <div class="col-lg-3 col-md-6 col-sm-6">
                    <div class="footer__about">
                    <div class="footer__about__logo">
                        <a href="./index.html">
                            <img src="@Url.Content("~/Classix/img/logo/" + Logo)" style="border-radius: 50%" alt="Logo" />
                        </a>
                    </div>

                        <ul>
                        
                            <li id="footerAddress">Address: @address</li>
                            <li id="footerPhone">Phone: @phone</li>
                            <li id="footerEmail">Email: @email</li>

                        </ul>

                </div>
            </div>
            
            <div class="col-lg-4 col-md-6 col-sm-6 offset-lg-1">
                <div class="footer__widget">
                    <ul>
                        <li><strong>Product</strong></li>
                        <li><a href="#">High-quality products</a></li>
                        <li><a href="#">Diverse designs</a></li>
                        <li><a href="#">Reasonable prices</a></li>
                        <li><a href="#">Many prestigious awards</a></li>    
                        <li></li>
                        <li><strong>Payment method</strong></li>
                        <li><a href="#">Payment by credit card</a></li>
                        <li><a href="#">Cash on delivery</a></li>
                        <li><a href="#">Payment via PayPal</a></li>
                        @*  <li>Payment by credit card</li>
                        <li>Cash on delivery</li>
                        <li>Payment via PayPal</li> *@
                    </ul>              
                    <ul>
                        <li><strong>Shipping</strong></li>
                        <li><a href="#">Nationwide delivery </a> </li>
                        <li><a href="#">Track orders 24/7</a></li>
                        <li><a href="#">Easy returns</a></li>
                        <li><a href="#">Careful storage</a></li>
                      
                    </ul>
                </div>
            </div>
            <div class="col-lg-4 col-md-12">
                <div class="footer__widget">
                    <h6>Join Our Newsletter Now</h6>
                    <p>
                        Get E-mail updates about our latest shop and special offers.
                    </p>
                    <form action="#">
                        <input type="text" placeholder="Enter your mail" />
                        <button type="submit" class="site-btn">Subscribe</button>
                    </form>
                    <div class="footer__widget__social">
                        <a href="#"><i class="fa fa-facebook"></i></a>
                        <a href="#"><i class="fa fa-instagram"></i></a>
                        <a href="#"><i class="fa fa-twitter"></i></a>
                        <a href="#"><i class="fa fa-pinterest"></i></a>
                    </div>
                    <div class="d-flex justify-content-center align-items-center mt-3">
                        <img src="https://www.dmca.com/PP2020/images/status/non-verified-badge.png" class="mx-3" style="max-width: 200px; max-height: 100px;">
                        <img src="https://images.dmca.com/Badges/_dmca_premi_badge_2.png?ID=3dd43ca1-6b70-4322-9f2c-6d9191e3cd18" class="mx-3" style="max-width: 200px; max-height: 100px;">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="footer__copyright">
                    <div class="footer__copyright__text">
                        <p>
                      
                            © 2018. Công Ty Cổ Phần Nội Thất CLASSIX. GPDKKD: 0303217354 do sở KH & ĐT TP.HCM cấp ngày 02/01/2007. GPMXH: 21/GP-BTTTT do Bộ Thông Tin và Truyền Thông cấp ngày 11/01/2021.
                            Địa chỉ 65 Huỳnh Thúc Kháng, phường Bến nghé, quận 1, thành phố Hồ Chí Minh. Điện thoại: 028 38125960. Email: cskh@classix.com.vn

                        </p>
                    </div>
                    <div class="footer__copyright__payment">
                        <img src="@Url.Content("~/Classix/img/payment-item.png")" alt="" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
