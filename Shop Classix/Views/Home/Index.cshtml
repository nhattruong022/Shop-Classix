@model IEnumerable<Shop_Classix.Models.ProductsModel>;


@{

    ViewData["Title"] = "Home Page";
}

 @* url: Đây là địa chỉ API sẽ nhận yêu cầu POST. /Home/ToggleFavorite là URL gửi tới phương thức ToggleFavorite trong controller HomeController trên server.
 type: Phương thức HTTP là POST, có nghĩa là dữ liệu sẽ được gửi lên server để thay đổi trạng thái sản phẩm.
 data: Dữ liệu gửi lên server là productId, chính là ID của sản phẩm mà người dùng muốn thay đổi trạng thái yêu thích.
 success: Hàm này sẽ được gọi nếu yêu cầu AJAX thành công (trả về kết quả từ server).
 error: Hàm này sẽ được gọi nếu yêu cầu AJAX gặp sự cố (lỗi kết nối hoặc lỗi từ server). *@

<script>
    function toggleFavorite(productId) {
        $.ajax({
            url: '/Home/ToggleFavorite', // Địa chỉ gọi đến action ToggleFavorite trong controller
            type: 'POST',
            data: { productId: productId },
            success: function (response) {
                if (response.success) {
                    // Tìm phần tử liên quan (biểu tượng tim và số lượng yêu thích)
                    const icon = $(`#favoriteCount_${productId}`).prev('a').find('i');
                    const favoriteCount = $(`#favoriteCount_${productId}`);

                    // Cập nhật biểu tượng tim và màu sắc
                    icon.toggleClass('fa-heart fa-heart-o');  // Chuyển đổi giữa tim đầy và tim rỗng
                    icon.css('color', response.isFavorite ? 'red' : 'gray');  // Thay đổi màu sắc tim

                    // Nếu số lượng yêu thích là 0, ẩn phần tử hiển thị số yêu thích
                    if (response.favoriteCount === 0) {
                        favoriteCount.hide(); // Ẩn phần tử số yêu thích
                    } else {
                        favoriteCount.show(); // Hiển thị lại phần tử số yêu thích
                        favoriteCount.text(response.favoriteCount);  // Cập nhật số lượng yêu thích
                    }
                } else {
                    alert('Failed to toggle favorite status.');
                }
            },
            error: function () {
                alert('An error occurred while processing your request.');
            }
        });
    }







</script>

