                        <div class="section-title">
                            <h2>Featured Product</h2>
                        </div>
                        <div class="featured__controls">
                            <ul>
                                <li class="active" data-filter="*">All</li>
                                <li data-filter=".oranges">Table</li>
                                <li data-filter=".fresh-meat">Chair</li>
                                <li data-filter=".vegetables">Bed</li>
                                <li data-filter=".fastfood">Light </li>
                            </ul>
                        </div>
                    </div>
                </div>


@* 
                Hiển thị danh sách sản phẩm từ Database *@
                <div class="row featured__filter">
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <div class="featured__item">
                                <div class="featured__item__pic set-bg"
                                     data-setbg="@Url.Content("~/Classix/img/" + item.Image)">
                                    <ul class="featured__item__pic__hover">
                                        <li>
                                            <a href="#"><i class="fa fa-heart"></i></a>
                                        </li>
                                        <li>
                                            <a href="#"><i class="fa fa-retweet"></i></a>
                                        </li>
                                        <li>
                                            <a href="#"><i class="fa fa-shopping-cart"></i></a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="featured__item__text">
                                    <h6><a href="#">@item.Name</a></h6>
                                    <h5>@item.Price.ToString("C")</h5>
                                    <p>Category: @item.category?.Name</p>
                                    <p>
                                        @for(var i=1;i<=5;i++)
                                        {
                                            if(i<=Math.Floor(item.Rating??0)) //lấy phần nguyên của rating, khi cần làm tròn xuống
                                            {
                                                <i class="fa fa-star" style="color:gold";></i>
                                            } 
                                            else if(i==Math.Ceiling(item.Rating??0)&&(item.Rating??0)%1!=0)  //ceiling lấy giá trị làm tròn gần nhất và làm tròn lên và kiểm tra phần lẻ
                                            {
                                                <i class="fas fa-star-half-alt" style="color: gold;"></i>
                                                //sao nửa
                                            }
                                            else
                                            {
                                                <i class="fa fa-star" style="color: lightgray;"></i> <!-- Sao rỗng -->
                                            }
                                        }

                                    </p>
                                    
                                </div>
                            </div>
                        </div>
                    }
                </div>
                


