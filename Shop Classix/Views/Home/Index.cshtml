        <!-- Featured Section Begin -->
        <section class="featured spad">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="section-title">
                            <h2>Featured Product</h2>
                        </div>
                        <div class="featured__controls">
                            <ul>
                                <li class="active" data-filter="*">All</li>
                                <li data-filter=".oranges">Table</li>
                                <li data-filter=".fresh-meat">Chair</li>
                                <li data-filter=".vegetables">Bed</li>
                                <li data-filter=".fastfood">Light </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="row featured__filter">
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <div class="featured__item">
                                <div class="featured__item__pic set-bg" data-setbg="@Url.Content("~/Classix/img/" + item.Image)">
                                    <a asp-action="Details" asp-controller="Home" asp-route-id="@item.Id">
                                        <img src="@Url.Content("~/Classix/img/" + item.Image)" alt="Product Image" />
                                    </a>

                                    <ul class="featured__item__pic__hover">
                                        <li>
                                            <a href="#"><i class="fa fa-heart"></i></a>
                                        </li>
                                        <li>
                                            <a href="#"><i class="fa fa-retweet"></i></a>
                                        </li>
                                        <li>
                                            <a href="#" onclick="addToCart(event, '@item.Id')">
                                                <i class="fa fa-shopping-cart"></i>
                                            </a>
                                        </li>
                                       
                                      @*   <li>
                                            <a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.Id"><i class="fa fa-shopping-cart"></i></a>
                                        </li> *@
                                    </ul>
                                </div>

                                <div class="featured__item__text">
                                    <h6><a>@item.Name</a></h6>
                                    <h5>@item.Price.ToString("C")</h5>
                                    <p>Category: @item.category?.Name</p>
                                     <p>
                                @for(var i=1;i<=5;i++)
                                {
                                if(i<=Math.Floor(item.Rating??0)) //lấy phần nguyên của rating, khi cần làm tròn xuống
                                {
                                <i class="fa fa-star" style="color:gold";></i>
                                }
                                else if(i==Math.Ceiling(item.Rating??0)&&(item.Rating??0)%1!=0)  //ceiling lấy giá trị làm tròn gần nhất và làm tròn lên và kiểm tra phần lẻ
                                {
                                <i class="fas fa-star-half-alt" style="color: gold;"></i>
                                //sao nửa
                                }
                                else
                                {
                                <i class="fa fa-star" style="color: lightgray;"></i> <!-- Sao rỗng -->
                                }
                                }

                                </p>
                               
                                </div>
                            </div>

                        </div>

                    }

                </div>
            </div>
            <script>
                function addToCart(event, itemId) {
                    event.preventDefault(); // Ngăn chặn việc tải lại trang

                    // Tạo dữ liệu để gửi
                    var formData = new URLSearchParams();
                    formData.append('id', itemId);
                    formData.append('quantity', '1'); // Số lượng mặc định là 1

                    // Gửi yêu cầu đến server
                    fetch('/Cart/AddToCart', { // Chỉ định rõ controller và action
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest' // Để server biết đây là yêu cầu AJAX
                        }
                    })
                        .then(response => {
                            if (response.ok) {
                                // Xử lý thành công (có thể cập nhật giỏ hàng hoặc hiển thị thông báo)
                                alert('Thêm vào giỏ thành công!');
                            } else {
                                // Xử lý lỗi
                                alert('Có lỗi xảy ra khi thêm vào giỏ.');
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Có lỗi xảy ra.');
                        });
                }
            </script>

