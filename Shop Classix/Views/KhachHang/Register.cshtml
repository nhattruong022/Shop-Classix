
@model Shop_Classix.Models.ViewModels.RegisterViewModel;



@section Link
{
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/bootstrap.min.css")" type="text/css">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/font-awesome.min.css")" type="text/css">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/elegant-icons.css")" type="text/css">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/nice-select.css")" type="text/css">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/jquery-ui.min.css")" type="text/css">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/owl.carousel.min.css")" type="text/css">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/slicknav.min.css")" type="text/css">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/style.css")" type="text/css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
}


<section class="text-center text-lg-start">
    <div class="container py-5">
        <div class="row align-items-center">

            <!-- Form Section -->
            <div class="col-lg-6 mb-5">
                <div class="card cascading-right bg-light" style="backdrop-filter: blur(30px);">
                    <div class="card-body p-5 shadow-5 text-center">
                        <h2 class="fw-bold mb-4">Sign Up Now</h2>



                        <form asp-action="Register" asp-controller="KhachHang" method="post">

                         @*     @if(!ViewData.ModelState.IsValid&&ViewData.ModelState["Email"]!=null)
                             {
                                 <div class="alert alert-danger">
                                     @foreach (var error in ViewData.ModelState["Email"].Errors)
                                     {
                                         <p>@error.ErrorMessage</p>
                                     }
                                 </div>
                             } *@

                            <div class="form-outline mb-4">
                                <label asp-for="Hoten" class="form-label">Full Name</label>
                                <input asp-for="Hoten" type="text" class="form-control" />
								<span asp-validation-for="Hoten" class="text-danger"></span>
                            </div>

                            <div class="form-outline mb-4">
                                <label asp-for="Email" class="form-label">Email Address</label>
                                <input asp-for="Email" type="email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="form-outline mb-4">
                                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                                <input asp-for="PhoneNumber" type="text" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>

                            <div class="form-outline mb-4">
                                <label asp-for="Password" class="form-label">Password</label>
                                <input asp-for="Password" type="password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                           

                            <!-- Newsletter Checkbox -->
                            <div class="form-check d-flex justify-content-center mb-4">
                                <input class="form-check-input me-2" type="checkbox" id="newsletter" checked />
                                <label class="form-check-label" for="newsletter">Subscribe to our newsletter</label>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary btn-block mb-4">Sign Up</button>
                        </form>

                            <!-- Social Media Signup -->
                            <p>or sign up with:</p>
                            <div class="d-flex justify-content-center">
                                <button type="button" class="btn btn-link btn-floating mx-2">
                                    <i class="fab fa-facebook-f"></i>
                                </button>
                                <button type="button" class="btn btn-link btn-floating mx-2">
                                    <i class="fab fa-google"></i>
                                </button>
                                <button type="button" class="btn btn-link btn-floating mx-2">
                                    <i class="fab fa-twitter"></i>
                                </button>
                                <button type="button" class="btn btn-link btn-floating mx-2">
                                    <i class="fab fa-github"></i>
                                </button>
                            </div>
                       

                    </div>
                </div>
            </div>

            <!-- Image Section -->
            <div class="col-lg-6">
                <img src="https://mdbootstrap.com/img/new/ecommerce/vertical/004.jpg" class="w-100 rounded-4 shadow-4" alt="Sign up image" />
            </div>
        </div>
    </div>
</section>
