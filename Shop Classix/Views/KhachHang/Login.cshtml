@model Shop_Classix.Models.ViewModels.LoginViewModel;

@{
    ViewData["Title"] = "Login Page";
}


@section Link
{
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/bootstrap.min.css")">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/font-awesome.min.css")">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/elegant-icons.css")">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/nice-select.css")">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/jquery-ui.min.css")">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/owl.carousel.min.css")">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/slicknav.min.css")">
<link rel="stylesheet" href="@Url.Content("~/Classix/user/css/style.css")">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
}


<section class="vh-100">
    <div class="container-fluid h-100">
        <div class="row h-100">
            <!-- Left Section -->
            <div class="col-md-6 text-black d-flex flex-column justify-content-center px-5">
                <div class="mb-4">
                    <i class="fas fa-crow fa-2x me-2" style="color: #709085;"></i>
                    <span class="h1 fw-bold">Logo</span>
                </div>

                <form asp-action="Login" asp-controller="KhachHang"  asp-route-returnUrl="@ViewBag.ReturnUrl" style="max-width: 400px;">
                    <h3 class="fw-normal mb-3" style="letter-spacing: 1px;">Log in</h3>

                    @if(!ViewData.ModelState.IsValid&&ViewData.ModelState["loi"]!=null)
                    {
                        <div class="alert alert-danger">
                            @ViewData.ModelState["loi"].Errors[0].ErrorMessage
                        </div>
                    }


                    <!-- Email Input -->
                    <div class="form-outline mb-4">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <input asp-for="Email" class="form-control form-control-lg" type="email" placeholder="Enter your email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-outline mb-4">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control form-control-lg" type="password" placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>


                    <!-- Login Button -->
                    <div class="mb-4">
                        <button type="submit" class="btn btn-info btn-lg w-100">Login</button>
                    </div>

                </form>
                    <!-- Links -->
                    <p class="small mb-2">
                        <a class="text-muted" href="#">Forgot password?</a>
                    </p>
                    <p>
                        Don't have an account? <a asp-action="Register" asp-controller="KhachHang" class="link-info">Register here</a>
                    </p>
        
            </div>

            <!-- Right Section -->
            <div class="col-md-6 px-0 d-none d-md-block">
                <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/img3.webp" alt="Login image" class="w-100 vh-100" style="object-fit: cover; object-position: left;">
            </div>
        </div>
    </div>
</section>