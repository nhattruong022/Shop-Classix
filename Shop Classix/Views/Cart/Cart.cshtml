@{
    ViewData["Title"] = "Cart Page";
}

@model Shop_Classix.Models.ViewModels.CartViewModel
@section Link
{
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400;600;900&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/bootstrap.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/font-awesome.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/elegant-icons.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/nice-select.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/jquery-ui.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/owl.carousel.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/slicknav.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/style.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/detail.css")" type="text/css" />
}

<div class="container">
    <main role="main" class="pb-3">
        <!-- Breadcrumb Section Begin -->
        <section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/Classix/img/classix.jpg")">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12 text-center">
                        <div class="breadcrumb__text">
                            <h2>Shopping Cart</h2>
                            <div class="breadcrumb__option">
                                <a href="./index.html">Home</a>
                                <span>Shopping Cart</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Breadcrumb Section End -->
        <!-- Shoping Cart Section Begin -->
       

        <section class="shoping-cart spad">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="shoping__cart__table">
                            @if (Model.Items.Count == 0)
                            {
                                <p>Your cart is empty.</p>
                            }
                            else
                            {
                                <table>
                                    <thead>
                                        <tr>
                                            <th class="shoping__product">Products</th>
                                            <th>Price</th>
                                            <th>Quantity</th>
                                            <th>Total</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            <tr>
                                                <td class="shoping__cart__item">
                                                    <img src="@Url.Content("~/Classix/img/" + item.ImageUrl)" alt="" />
                                                    <h5>@item.ProductName</h5>
                                                </td>
                                                <td class="shoping__cart__price">@item.Price.ToString("C")VNĐ</td>
                                                <td class="shoping__cart__quantity">
                                                    <input type="number" value="@item.Quantity" min="1" data-id="@item.ProductId" class="quantity-input" />
                                                </td>
                                                <td class="shoping__cart__total">@((item.Price * item.Quantity).ToString("C"))VNĐ</td>
                                                <td>
                                                    <form asp-action="RemoveFromCart" asp-controller="Cart" method="post">
                                                        <input type="hidden" name="id" value="@item.ProductId" />
                                                        <button type="submit" class="btn btn-danger">Remove</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>

                        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
                        <script>
                            $(document).ready(function () {
                                $('.quantity-input').on('change', function () {
                                    var quantity = $(this).val();
                                    var productId = $(this).data('id');

                                    $.ajax({
                                        url: '@Url.Action("UpdateQuantity", "Cart")', // URL đến phương thức cập nhật
                                        type: 'POST',
                                        data: { id: productId, quantity: quantity },
                                        success: function (response) {
                                            // Cập nhật lại tổng tiền hoặc làm gì đó sau khi cập nhật thành công
                                            location.reload(); // Tải lại trang để cập nhật giỏ hàng
                                        },
                                        error: function () {
                                            alert('Error updating quantity.'); // Thông báo lỗi
                                        }
                                    });
                                });
                            });
                        </script>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-12">
                        <div class="shoping__cart__btns">
                            <a asp-action="Index" asp-controller="Home" class="primary-btn cart-btn">CONTINUE SHOPPING</a>
                            <a href="#" class="primary-btn cart-btn cart-btn-right">
                                <span class="icon_loading"></span>
                                Upadate Cart
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="shoping__continue">
                            <div class="shoping__discount">
                                <h5>Discount Codes</h5>
                                <form action="#">
                                    <input type="text" placeholder="Enter your coupon code" />
                                    <button type="submit" class="site-btn">
                                        APPLY COUPON
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="shoping__checkout">
                            <h5>Cart Total</h5>
                            <ul>
                                @* <li>Subtotal <span>40.000.000VNĐ</span></li> *@
                                <li>Total <span>@Model.TotalAmount.ToString("C")VNĐ</span></li>
                            </ul>
                            <a asp-action="CheckOut" asp-controller="Cart" class="primary-btn">PROCEED TO CHECKOUT</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Shoping Cart Section End -->
    </main>
</div>



@section Script {
    <script src="@Url.Content("~/Classix/user/js/jquery-3.3.1.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery.nice-select.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery-ui.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery.slicknav.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/mixitup.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/owl.carousel.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/main.js")"></script>
}
