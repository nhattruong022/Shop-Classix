@model IEnumerable<Shop_Classix.Models.ViewModels.CartItemViewModel>


@{
	ViewData["Title"] = "Check Out Page";
}



@section Link
{
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400;600;900&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/bootstrap.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/font-awesome.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/elegant-icons.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/nice-select.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/jquery-ui.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/owl.carousel.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/slicknav.min.css")" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Classix/user/css/style.css")" type="text/css" />
}


<section class="checkout spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h6>
                    <span class="icon_tag_alt"></span> Have a coupon?
                    <a href="#">Click here</a> to enter your code
                </h6>
            </div>
        </div>
        <div class="checkout__form">
            <h4>Billing Details</h4>
            <form action="#">

                <div class="form-check mb-4">
                    <label class="form-check-label" for="paypal">
                        Same as customer information
                    </label>
                    <input class="form-check-input" type="checkbox"/>
                </div>
                
                <div class="row">
                    <!-- Left Section: Customer Information -->
                    <div class="col-lg-8 col-md-6">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="checkout__input">
                                    <p>Receiver<span>*</span></p>
                                    <input type="text" />
                                </div>
                            </div>
                        </div>
                        <div class="checkout__input">
                            <p>Town/City<span>*</span></p>
                            <input type="text" value="HCM city" />
                        </div>
                        <div class="checkout__input">
                            <p>Address<span>*</span></p>
                            <input type="text"
                                   placeholder="Your Address"
                                   class="checkout__input__add" />
                        </div>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="checkout__input">
                                    <p>Phone<span>*</span></p>
                                    <input type="text" />
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="checkout__input">
                                    <p>Email<span>*</span></p>
                                    <input type="text" />
                                </div>
                            </div>
                        </div>
                        <div class="checkout__input">
                            <p>Order notes<span>*</span></p>
                            <input type="text"
                                   placeholder="Notes about your order, e.g. special notes for delivery." />
                        </div>
                    </div>

                    <!-- Right Section: Order Summary -->
                    <div class="col-lg-4 col-md-6">
                        <div class="checkout__order border p-3 shadow-sm">
                            <h4 class="mb-4 text-center">Your Order</h4>
                            <div class="checkout__order__products">
                                <div class="row font-weight-bold mb-3">
                                    <div class="col-6">Product</div>
                                    <div class="col-3 text-center">Quantity</div>
                                    <div class="col-3 text-right">Total</div>
                                </div>
                            </div>
                            <ul class="list-unstyled">
                                @foreach (var item in Model)
                                {
                                    <li class="row mb-2">
                                        <div class="col-6">@item.ProductName</div>
                                        <div class="col-3 text-center">@item.Quantity</div>
                                        <div class="col-3 text-right">@item.Price</div>
                                    </li>
                                }
                            </ul>
                            <div class="checkout__order__subtotal font-weight-bold mt-3 d-flex justify-content-between">
                                <span>Subtotal:</span>
                                <span>@Model.Sum(item => item.TotalPrice).ToString("C")</span>
                            </div>
                            <div class="checkout__order__total font-weight-bold mt-3 d-flex justify-content-between">
                                <span>Total:</span>
                                <span>@Model.Sum(item => item.TotalPrice).ToString("C")</span>
                            </div>
                            <p class="mt-3 text-muted small">
                                Lorem ipsum dolor sit amet, consectetur adip elit, sed
                                do eiusmod tempor incididunt ut labore et dolore magna
                                aliqua.
                            </p>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="payment" />
                                <label class="form-check-label" for="payment">
                                    Check Payment
                                </label>
                            </div>
                            <div class="form-check mb-4">
                                <input class="form-check-input" type="checkbox" id="paypal" />
                                <label class="form-check-label" for="paypal">
                                    COD
                                </label>
                            </div>
                            <button type="submit" class="btn btn-primary btn-block">
                                PLACE ORDER
                            </button>
                        </div>
                    </div>
                </div>
            </form>

        </div>
    </div>
</section>

        

    @section Script
    {
    <script src="@Url.Content("~/Classix/user/js/jquery-3.3.1.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery.nice-select.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery-ui.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/jquery.slicknav.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/mixitup.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/owl.carousel.min.js")"></script>
    <script src="@Url.Content("~/Classix/user/js/main.js")"></script>
    }