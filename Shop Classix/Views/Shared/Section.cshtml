@model IEnumerable<Shop_Classix.Models.ProductsModel>


<section class="hero hero-normal">
    <div class="container">
        <div class="row">
            <!-- Danh mục -->
            <div class="col-lg-3">
                <div class="hero__categories">
                    <div class="hero__categories__all">
                        <i class="fa fa-bars"></i>
                        <span>All departments</span>
                    </div>
                    <ul class="list-unstyled">
                        <li><a href="#">Fresh Meat</a></li>
                        <li><a href="#">Vegetables</a></li>
                        <li><a href="#">Fruit & Nut Gifts</a></li>
                        <li><a href="#">Fresh Berries</a></li>
                        <li><a href="#">Ocean Foods</a></li>
                        <li><a href="#">Butter & Eggs</a></li>
                        <li><a href="#">Fastfood</a></li>
                        <li><a href="#">Fresh Onion</a></li>
                        <li><a href="#">Papaya & Crisps</a></li>
                        <li><a href="#">Oatmeal</a></li>
                        <li><a href="#">Fresh Bananas</a></li>
                    </ul>
                </div>
            </div>

            <!-- Form tìm kiếm -->
            <div class="col-lg-9">
                <form asp-action="TimKiem" asp-controller="Home" method="get" class="d-flex">
                    <!-- Chọn danh mục -->
                    <div class="me-4">
                        <select name="categoryId" class="form-select">
                            <option value="">--Select Categories--</option>
                            @if (ViewBag.categories != null)
                            {
                                foreach (SelectListItem category in ViewBag.categories)
                                {
                                    <option value="@category.Value">@category.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Tìm kiếm từ khóa -->
                    <div class="me-4">
                        <input name="keyword" type="text" class="form-control" placeholder="What do you need?" />
                    </div>

                    <!-- Nút tìm kiếm -->
                    <div>
                        <button type="submit" class="site-btn btn btn-primary">SEARCH</button>
                    </div>
                </form>
            </div>


        <!-- Hỗ trợ điện thoại -->
        <div class="hero__search__phone mt-3">
            <div class="hero__search__phone__icon">
                <i class="fa fa-phone"></i>
            </div>
            <div class="hero__search__phone__text">
                <h5>+84 399 459 299</h5>
                <span>support 24/7 time</span>
            </div>
        </div>
    </div>
</section>
